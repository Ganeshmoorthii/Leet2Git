{
  "manifest_version": 3,
  "name": "Leet2Git - LeetCode to GitHub Auto Archiver",
  "version": "1.0.0",
  "description": "Automatically archives your accepted LeetCode solutions to a GitHub repo, with problem statement, examples, constraints, and revision-friendly formatting.",
  "permissions": ["storage", "activeTab", "scripting", "notifications"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Leet2Git Settings"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
